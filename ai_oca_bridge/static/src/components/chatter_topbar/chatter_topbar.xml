<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="ai_oca_bridge.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//span[@class='o-mail-Chatter-topbarGrow flex-grow-1 pe-2']"
            position="before"
        >
            <ChatterAITopbar
                record="this"
                t-if="props.webRecord and props.webRecord.data.ai_bridge_info and props.webRecord.data.ai_bridge_info.length > 0"
            />
        </xpath>
    </t>
</templates>
